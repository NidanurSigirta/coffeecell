# ============================================
# CoffeeCell — Environment Variables (Template)
# ============================================
# Kullanım: cp .env.example .env  →  .env içindeki değerleri doldur.
# .env dosyası git'e GİTMEZ (gitignore'da).

# ---------- Application ----------
APP_NAME=CoffeeCell
APP_ENV=development
APP_DEBUG=true

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=coffeecell
POSTGRES_PASSWORD=coffeecell_dev_password
POSTGRES_DB=coffeecell
DATABASE_URL=postgresql+asyncpg://coffeecell:coffeecell_dev_password@postgres:5432/coffeecell

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000