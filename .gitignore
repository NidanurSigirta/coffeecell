# ============================================
# CoffeeCell — .gitignore
# ============================================

# ---------- Secrets & environment ----------
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# ---------- Python / Backend ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
.tox/

# Alembic auto-generated SQL
backend/alembic/versions/*.sql

# ---------- Node / Frontend ----------
node_modules/
.pnp
.pnp.js
coverage/
build/
dist/
.vite/
.turbo/
*.local

# Vite / React
frontend/dist/
frontend/.eslintcache

# ---------- Testing ----------
playwright-report/
test-results/
.playwright/

# ---------- IDE'ler ----------
.vscode/
!.vscode/settings.example.json
.idea/
*.swp
*.swo
*~

# ---------- İşletim sistemi ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Docker ----------
.docker-volumes/
pgdata/
redisdata/
esdata/

# ---------- Loglar ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Diğer ----------
.cache/
tmp/
temp/